# Environment Configuration Example
# Copy this file to .env and update with your configuration

# Server Configuration
PORT=8080

# Database Configuration
# IMPORTANT: Update DB_PASSWORD dan DB_NAME sesuai dengan setup PostgreSQL Anda
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=sibvet_lampung

# JWT Configuration
# IMPORTANT: Change JWT_SECRET to a secure random string di production
JWT_SECRET=secret_token123
JWT_EXPIRED_HOURS=24

# Email (SMTP) Configuration for Notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_RETRIES=3

# Frontend login URL (used in verification approved email)
APP_LOGIN_URL=http://localhost:3000/login
