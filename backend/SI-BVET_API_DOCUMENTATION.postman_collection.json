    {
      "name": "03. Superadmin",
      "item": [
        {
          "name": "Create Admin Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_superadmin}}"
              },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Admin Baru\",\n  \"email\": \"admin.baru@mail.com\",\n  \"phone\": \"08123456780\",\n  \"password\": \"secret123\",\n  \"position\": \"Staf\",\n  \"unit_lab\": \"Lab A\",\n  \"employee_no\": \"EMP-001\",\n  \"role\": \"admin\",\n  \"is_verified\": true\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": "{{base_url}}/superadmin/admin-accounts",
            "description": "Buat akun admin atau superadmin."
          }
        },
        {
          "name": "Get Admin Accounts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_superadmin}}" }
            ],
            "url": "{{base_url}}/superadmin/admin-accounts?role={{role_filter}}",
            "description": "Ambil daftar akun admin/superadmin, opsional filter role=admin atau role=superadmin."
