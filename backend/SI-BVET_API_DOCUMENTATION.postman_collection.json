        },
        {
          "name": "Delete Admin Account",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_superadmin}}" }
            ],
            "url": "{{base_url}}/superadmin/admin-accounts/{{user_id}}",
            "description": "Hapus akun admin/superadmin."
          }
        },
        {
          "name": "Create Test Service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_superadmin}}"
              },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"test_name\": \"PCR Swab\",\n  \"unit_lab\": \"Molekuler\",\n  \"target\": \"Virus\",\n  \"method\": \"PCR\",\n  \"result_type\": \"Kualitatif\",\n  \"test_reference\": \"Ref-001\",\n  \"price\": 250000,\n  \"duration\": \"3 hari\",\n  \"description\": \"Contoh layanan uji\",\n  \"sample_reqmt\": \"Swab\"\n}",
              "options": {
