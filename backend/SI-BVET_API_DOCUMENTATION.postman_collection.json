    {
      "name": "05. Customer",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_customer}}" }
            ],
            "url": "{{base_url}}/customer/notifications",
            "description": "Daftar notifikasi milik customer."
          }
        },
        {
          "name": "Mark Notification As Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_customer}}" }
            ],
            "url": "{{base_url}}/customer/notifications/{{notification_id}}/read",
            "description": "Tandai satu notifikasi sebagai terbaca."
          }
        },
        {
          "name": "Mark All Notifications As Read",
          "request": {
            "method": "PATCH",
            "header": [
