  "item": [
    {
      "name": "01. Public Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "fullname", "value": "PT Maju Sehat", "type": "text" },
                {
                  "key": "email",
                  "value": "customer@mail.com",
                  "type": "text"
                },
                { "key": "phone", "value": "08123456789", "type": "text" },
                {
                  "key": "institution",
                  "value": "PT Maju Sehat",
                  "type": "text"
                },
                { "key": "password", "value": "secret123", "type": "text" },
                { "key": "registration_doc", "type": "file", "src": "" }
              ]
            },
            "url": "{{base_url}}/auth/register",
            "description": "Registrasi customer baru. Field file wajib: registration_doc."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@mail.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": "{{base_url}}/auth/login",
            "description": "Login user dan ambil JWT token. Simpan hasil token ke `access_token` secara manual atau lewat test script Postman."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@mail.com\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": "{{base_url}}/auth/forgot-password",
            "description": "Meminta link reset password ke email terdaftar."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"newsecret123\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": "{{base_url}}/auth/reset-password/{{password_reset_user_id}}/{{password_reset_token}}?expires={{password_reset_expires}}&signature={{password_reset_signature}}",
            "description": "Reset password memakai parameter path id/token dan query expires/signature."
          }
        },
        {
          "name": "Verify Email Login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/verify-email/{{one_time_login_user_id}}/{{one_time_login_token}}?expires={{one_time_login_expires}}&signature={{one_time_login_signature}}",
            "description": "Verifikasi one-time login link dan ambil JWT token."
          }
        }
      ]
    },
