          "name": "Import Test Services",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_superadmin}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "" }]
            },
            "url": "{{base_url}}/superadmin/test-services/import",
            "description": "Import test service dari file Excel. Field file wajib: file."
          }
        },
        {
          "name": "Upload Sample Template",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_superadmin}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "" }]
            },
            "url": "{{base_url}}/superadmin/submissions/samples/template",
            "description": "Upload template sample submission. Field file wajib: file."
          }
        },
        {
          "name": "Get Activity Logs",
          "request": {
            "method": "GET",
            "header": [
