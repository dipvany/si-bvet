    {
      "name": "04. Admin",
      "item": [
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": "{{base_url}}/admin/customers",
            "description": "Daftar semua customers."
          }
        },
        {
          "name": "Verify Customer",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": "{{base_url}}/admin/customers/{{user_id}}/verify",
            "description": "Verifikasi customer berdasarkan ID user."
          }
        },
        {
          "name": "Reject Customer",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": "{{base_url}}/admin/customers/{{user_id}}/reject",
            "description": "Tolak verifikasi customer dan hapus datanya."
          }
        },
        {
          "name": "Get All Submissions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": "{{base_url}}/admin/submissions?page=1&per_page=20",
            "description": "Ambil daftar submission untuk admin dengan pagination. Query params: page default 1, per_page default 20, maksimum disarankan 100. Response berisi data dan meta pagination."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token_admin}}" }
                ],
                "url": "{{base_url}}/admin/submissions?page=1&per_page=20"
              },
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"Submissions retrieved successfully\",\n  \"data\": {\n    \"data\": [\n      {\n        \"id\": 12,\n        \"no_ticket\": \"TCK-2026-0012\",\n        \"user_id\": 5,\n        \"type_service\": \"PCR\",\n        \"purpose_of_test\": \"Screening\",\n        \"samples_count\": 2,\n        \"process_status\": \"pending_verification\"\n      },\n      {\n        \"id\": 11,\n        \"no_ticket\": \"TCK-2026-0011\",\n        \"user_id\": 4,\n        \"type_service\": \"ELISA\",\n        \"purpose_of_test\": \"Monitoring\",\n        \"samples_count\": 1,\n        \"process_status\": \"done\"\n      }\n    ],\n    \"meta\": {\n      \"page\": 1,\n      \"per_page\": 20,\n      \"total\": 52,\n      \"total_pages\": 3\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Approve Submission",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": "{{base_url}}/admin/submissions/{{submission_id}}/approve",
            "description": "Setujui submission tertentu."
          }
        },
        {
          "name": "Reject Submission",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": "{{base_url}}/admin/submissions/{{submission_id}}/reject",
            "description": "Tolak submission tertentu."
          }
        },
        {
          "name": "Export Submissions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"export_all\": true,\n  \"submission_ids\": [1, 2, 3]\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": "{{base_url}}/admin/submissions/export",
            "description": "Export submission ke Excel. Set export_all=true untuk semua data."
          }
        },
        {
          "name": "Get All Test Services",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
